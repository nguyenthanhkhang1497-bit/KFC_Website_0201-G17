@model IEnumerable<KFC_Website.Models.OrderResult>

@{
    ViewBag.Title = "Admin Dashboard - KFC";
}

<div class="container" style="margin-top: 30px; margin-bottom: 60px;">
    <h2 style="color: #e4002b; font-weight: bold; margin-bottom: 25px;">BẢNG ĐIỀU KHIỂN QUẢN TRỊ (ADMIN)</h2>

    <!-- Thống kê tổng quan dạng thẻ Card -->
    <div class="row" style="margin-bottom: 30px;">
        <div class="col-md-3">
            <div style="background: #e4002b; color: #fff; padding: 20px; border-radius: 8px;">
                <h4 style="margin: 0; font-size: 14px; text-transform: uppercase;">Doanh thu thực nhận</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 10px 0 0;">@string.Format("{0:N0} đ", ViewBag.TotalRevenue)</p>
            </div>
        </div>
        <div class="col-md-3">
            <div style="background: #202124; color: #fff; padding: 20px; border-radius: 8px;">
                <h4 style="margin: 0; font-size: 14px; text-transform: uppercase;">Tổng số đơn hàng</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 10px 0 0;">@ViewBag.TotalOrders</p>
            </div>
        </div>
        <div class="col-md-3">
            <div style="background: #f39c12; color: #fff; padding: 20px; border-radius: 8px;">
                <h4 style="margin: 0; font-size: 14px; text-transform: uppercase;">Đơn chờ xử lý</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 10px 0 0;">@ViewBag.PendingOrders</p>
            </div>
        </div>
        <div class="col-md-3">
            <div style="background: #27ae60; color: #fff; padding: 20px; border-radius: 8px;">
                <h4 style="margin: 0; font-size: 14px; text-transform: uppercase;">Món ăn trên Menu</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 10px 0 0;">@ViewBag.TotalMenuItems</p>
            </div>
        </div>
    </div>

    <!-- Phím tắt truy cập nhanh -->
    <div style="margin-bottom: 25px;">
        <a href="@Url.Action("ManageMenu", "Home")" class="btn btn-primary" style="margin-right: 10px;">Quản lý Thực Đơn</a>
        <a href="@Url.Action("OrderList", "Home")" class="btn btn-warning" style="color: #fff;">Quản lý Toàn bộ Đơn hàng</a>
    </div>

    <!-- Bảng 5 đơn hàng mới nhất -->
    <h4>Đơn hàng gần đây</h4>
    <table class="table table-bordered table-hover" style="background: #fff; margin-top: 15px;">
        <thead style="background: #202124; color: #fff;">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>SĐT</th>
                <th>Tổng tiền</th>
                <th>Thời gian</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td style="font-weight: bold; color: #e4002b;">@o.OrderId</td>
                    <td>@o.CustomerName</td>
                    <td>@o.Phone</td>
                    <td style="font-weight: bold;">@string.Format("{0:N0} đ", o.TotalAmount)</td>
                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge" style="background: #f39c12; padding: 5px 8px;">@o.Status</span></td>
                    <td>
                        <a href="@Url.Action("OrderDetails", "Home", new { id = o.OrderId })" class="btn btn-xs btn-info" style="color: #fff;">Xem</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>