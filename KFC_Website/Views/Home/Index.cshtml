@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CỬA HÀNG KFC CÓ MẶT TẠI VIỆT NAM</title>

    <link rel="stylesheet" href="~/Content/style.css" />
</head>

<body>

    <!-- HEADER -->
    <header class="header">

        <div class="header-container">

            <!-- LOGO -->
            <div class="logo">
                <h1>KFC</h1>
            </div>

            <!-- MENU -->
            <nav class="menu">
                <a href="#">Trang chủ</a>
                <a href="#san-pham">Sản phẩm</a>
                <a href="#" id="cart-toggle-link" onclick="toggleCart(); return false;">Giỏ hàng</a>
                <a href="#">Liên lạc</a>
            </nav>

            <!-- GIO HANG ICON -->
            <div class="cart-icon" id="cart-icon" onclick="toggleCart()">
                🛒
                <span class="cart-count" id="cart-count">0</span>
            </div>
            <!-- Cụm nút Đăng nhập & Đăng ký -->
            <div style="display: inline-flex; gap: 8px; margin-left: 15px; align-items: center;">
                <button type="button" onclick="openModal('loginModal')" style="padding: 6px 14px; border: 1px solid #e4002b; background: transparent; color: #e4002b; border-radius: 4px; cursor: pointer; font-weight: bold;">
                    Đăng nhập
                </button>
                <button type="button" onclick="openModal('registerModal')" style="padding: 6px 14px; border: none; background: #e4002b; color: #fff; border-radius: 4px; cursor: pointer; font-weight: bold;">
                    Đăng ký
                </button>
            </div>

        </div>

    </header>


    <!-- BANNER -->
    <section class="banner">

        <div class="banner-content">

            <h1>KFC VIỆT NAM</h1>

            <p>
                Hương vị thơm ngon – Ăn là ghiền
            </p>

            <button onclick="document.getElementById('san-pham').scrollIntoView({behavior:'smooth'})">
                Xem sản phẩm
            </button>

        </div>

    </section>


    <!-- PHAN CONTAINER -->
    <main class="container">

        <!-- TIM KIEM SAN PHAM -->
        <section class="search-section">
            <h2>Tìm kiếm sản phẩm</h2>

            <form class="search-form" id="search-form">
                <input type="text"
                       id="search-input"
                       placeholder="Nhập từ khóa...">
                <button type="submit">Tìm kiếm</button>
            </form>
            <p class="search-result-msg" id="search-result-msg"></p>
        </section>

        <!-- PHAN DANH MUC SAN PHAM -->
        <nav class="category-section" id="danh-muc">
            <h2>Danh mục sản phẩm</h2>

            <ul class="category-menu">
                <li><a href="#san-pham" data-category="all" class="active">Tất cả</a></li>
                <li><a href="#san-pham" data-category="ga">Gà rán</a></li>
                <li><a href="#san-pham" data-category="burger">Burger</a></li>
                <li><a href="#san-pham" data-category="combo">Combo</a></li>
                <li><a href="#san-pham" data-category="mon-an-kem">Phụ kiện</a></li>
            </ul>
        </nav>

        <!-- SAN PHAM NOI BAT -->
        <section class="product-section" id="noi-bat">
            <h2>Sản phẩm nổi bật</h2>

            <div class="featured-grid">
                <article class="featured-card">
                    <img src="https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?auto=format&fit=crop&w=700&q=80" alt="Gà rán">
                    <h3>Gà rán</h3>
                    <p>Mô tả sản phẩm</p>
                    <strong>49.000đ</strong>
                    <button class="btn-add-cart" onclick="addToCart('Gà rán', 49000, 'https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?auto=format&fit=crop&w=700&q=80')">Thêm vào giỏ</button>
                </article>

                <article class="featured-card">
                    <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=700&q=80" alt="Burger">
                    <h3>Burger gà</h3>
                    <p>Mô tả sản phẩm</p>
                    <strong>45.000đ</strong>
                    <button class="btn-add-cart" onclick="addToCart('Burger gà', 45000, 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=700&q=80')">Thêm vào giỏ</button>
                </article>

                <article class="featured-card">
                    <img src="https://images.unsplash.com/photo-1562967914-608f82629710?auto=format&fit=crop&w=700&q=80" alt="Combo gà">
                    <h3>Combo gà</h3>
                    <p>Mô tả sản phẩm</p>
                    <strong>99.000đ</strong>
                    <button class="btn-add-cart" onclick="addToCart('Combo gà', 99000, 'https://images.unsplash.com/photo-1562967914-608f82629710?auto=format&fit=crop&w=700&q=80')">Thêm vào giỏ</button>
                </article>
            </div>
        </section>

        <!-- DANH SACH SAN PHAM -->
        <section class="product-section" id="san-pham">
            <h2>Danh sách sản phẩm</h2>

            <!-- Thong bao khong tim thay -->
            <p class="no-result" id="no-result" style="display:none;">Không tìm thấy sản phẩm phù hợp.</p>

            <div class="product-grid" id="product-grid">
            </div>
        </section>

    </main>

    <!-- CART OVERLAY -->
    <div class="cart-overlay" id="cart-overlay" onclick="toggleCart()"></div>

    <!-- CART SIDEBAR -->
    <aside class="cart-sidebar" id="cart-sidebar">
        <div class="cart-header">
            <h2>🛒 Giỏ hàng</h2>
            <button class="cart-close" onclick="toggleCart()">✕</button>
        </div>

        <div class="cart-items" id="cart-items">
            <!-- Cart items se duoc them bang JS -->
            <p class="cart-empty" id="cart-empty">Giỏ hàng trống.</p>
        </div>

        <div class="cart-footer">
            <div class="cart-total">
                <span>Tổng cộng:</span>
                <strong id="cart-total-price">0đ</strong>
            </div>
            <button class="btn-checkout" onclick="handleCheckout()">Đặt hàng</button>
            <button class="btn-clear-cart" onclick="clearCart()">Xóa tất cả</button>
        </div>
    </aside>

    <!-- Toast thong bao -->
    <div class="toast" id="toast"></div>
    <!-- MODAL ĐĂNG NHẬP -->
    <div id="loginModal" class="auth-modal" style="display:none;">
        <div class="auth-modal-content">
            <span class="close-btn" onclick="closeModal('loginModal')">&times;</span>
            <h3>Đăng Nhập Khách Hàng</h3>
            <div class="form-group">
                <label>Email:</label>
                <input type="email" id="loginEmail" class="form-control" placeholder="Nhập email...">
            </div>
            <div class="form-group">
                <label>Mật khẩu:</label>
                <input type="password" id="loginPassword" class="form-control" placeholder="Nhập mật khẩu...">
            </div>
            <button type="button" class="btn btn-danger btn-block mt-3" onclick="submitLogin()">Đăng nhập</button>
        </div>
    </div>

    <!-- MODAL ĐĂNG KÝ -->
    <div id="registerModal" class="auth-modal" style="display:none;">
        <div class="auth-modal-content">
            <span class="close-btn" onclick="closeModal('registerModal')">&times;</span>
            <h3>Đăng Ký Tài Khoản</h3>
            <div class="form-group">
                <label>Họ và tên:</label>
                <input type="text" id="regFullName" class="form-control" placeholder="Nguyễn Văn A">
            </div>
            <div class="form-group">
                <label>Email:</label>
                <input type="email" id="regEmail" class="form-control" placeholder="email@gmail.com">
            </div>
            <div class="form-group">
                <label>Số điện thoại:</label>
                <input type="text" id="regPhone" class="form-control" placeholder="0901234567">
            </div>
            <div class="form-group">
                <label>Địa chỉ:</label>
                <input type="text" id="regAddress" class="form-control" placeholder="Số nhà, đường...">
            </div>
            <div class="form-group">
                <label>Mật khẩu:</label>
                <input type="password" id="regPassword" class="form-control" placeholder="Nhập mật khẩu...">
            </div>
            <button type="button" class="btn btn-danger btn-block mt-3" onclick="submitRegister()">Đăng ký ngay</button>
        </div>
    </div>

    <style>
        /* CSS giao diện Popup */
        .auth-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.5);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-modal-content {
            background: #fff;
            padding: 25px;
            border-radius: 8px;
            width: 400px;
            position: relative;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .close-btn {
            position: absolute;
            right: 15px;
            top: 10px;
            font-size: 24px;
            cursor: pointer;
        }

        .form-group {
            margin-bottom: 12px;
        }

            .form-group label {
                font-weight: bold;
                display: block;
                margin-bottom: 4px;
            }

            .form-group input {
                width: 100%;
                padding: 8px;
                box-sizing: border-box;
            }
    </style>
    <script src="~/Scripts/script.js"></script>
    <script>
        // Bật/tắt Popup
        function openModal(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) modal.style.display = 'flex';
        }

        function closeModal(modalId) {
            var modal = document.getElementById(modalId);
            if (modal) modal.style.display = 'none';
        }

        // Gửi dữ liệu Đăng Ký về Controller
        function submitRegister() {
            var data = {
                FullName: document.getElementById('regFullName').value,
                Email: document.getElementById('regEmail').value,
                Phone: document.getElementById('regPhone').value,
                Address: document.getElementById('regAddress').value,
                Password: document.getElementById('regPassword').value
            };

            fetch('/Home/RegisterCustomer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(res => {
                    alert(res.Message);
                    if (res.Success) {
                        closeModal('registerModal');
                        openModal('loginModal');
                    }
                })
                .catch(err => console.error(err));
        }

        // Gửi dữ liệu Đăng Nhập về Controller
        function submitLogin() {
            var email = document.getElementById('loginEmail').value;
            var password = document.getElementById('loginPassword').value;

            fetch('/Home/LoginCustomer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email, password: password })
            })
                .then(res => res.json())
                .then(res => {
                    alert(res.Message);
                    if (res.Success) {
                        closeModal('loginModal');
                        location.reload();
                    }
                })
                .catch(err => console.error(err));
        }
    </script>
    <script>
        // 1. Mở modal khi bấm nút "Đặt hàng" ở giỏ hàng
        function handleCheckout() {
            if (typeof cart === 'undefined' || cart.length === 0) {
                alert("Giỏ hàng của bạn đang trống! Vui lòng chọn món trước.");
                return;
            }
            document.getElementById('checkoutModal').style.display = 'block';
        }

        // 2. Đóng modal
        function closeCheckoutModal() {
            document.getElementById('checkoutModal').style.display = 'none';
        }

        // 3. Gửi đơn hàng khi bấm nút "Xác nhận đặt hàng" trên modal
        function confirmAndPlaceOrder() {
            var customerName = document.getElementById('custName').value.trim();
            var phone = document.getElementById('custPhone').value.trim();
            var address = document.getElementById('custAddress').value.trim();

            if (!customerName) {
                alert("Vui lòng nhập họ tên người nhận!");
                return;
            }
            if (!phone) {
                alert("Vui lòng nhập số điện thoại nhận hàng!");
                return;
            }
            if (!address) {
                alert("Vui lòng nhập địa chỉ nhận hàng!");
                return;
            }

            var total = cart.reduce(function (sum, item) {
                return sum + (item.price * item.quantity);
            }, 0);

            var orderData = {
                CustomerName: customerName,
                Phone: phone,
                Address: address,
                TotalAmount: total,
                Items: cart.map(function (item) {
                    return {
                        Name: item.name,
                        Quantity: item.quantity,
                        Price: item.price
                    };
                })
            };

            fetch('/Home/CreateOrder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderData)
            })
                .then(function (res) { return res.json(); })
                .then(function (res) {
                    if (res.Success) {
                        alert(res.Message);
                        cart.length = 0;
                        if (typeof updateCartUI === 'function') updateCartUI();
                        if (typeof renderCart === 'function') renderCart();
                        closeCheckoutModal();

                        // Chuyển hướng trực tiếp đến trang chi tiết đơn hàng vừa tạo
                        window.location.href = '/Home/OrderDetails/' + res.OrderId;
                    } else {
                        alert(res.Message);
                    }
                })
                .catch(function (err) {
                    console.error("Lỗi đặt hàng:", err);
                    alert("Có lỗi xảy ra khi gửi đơn hàng!");
                });
        }
        document.addEventListener("DOMContentLoaded", function () {
            var searchInput = document.getElementById("search-input");
            var searchForm = document.getElementById("search-form");

            if (searchInput) {
                // Lọc khi người dùng gõ từ khóa
                searchInput.addEventListener("input", function () {
                    var keyword = this.value.toLowerCase().trim();
                    var productCards = document.querySelectorAll(".menu-item, .product-card, .col-md-4, .col-sm-6, .item");

                    productCards.forEach(function (card) {
                        var titleEl = card.querySelector("h3, h4, h5, .product-title, .card-title, .name");
                        if (titleEl) {
                            var titleText = titleEl.textContent.toLowerCase();
                            if (titleText.includes(keyword)) {
                                card.style.display = "";
                            } else {
                                card.style.display = "none";
                            }
                        }
                    });
                });
            }

            // Chặn form tự load lại trang khi bấm Enter hoặc nút Tìm kiếm
            if (searchForm) {
                searchForm.addEventListener("submit", function (e) {
                    e.preventDefault();
                });
            }
        });
    </script>
    <!-- Modal Popup Nhập Thông Tin Khách Hàng -->
    <div id="checkoutModal" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6);">
        <div style="background: #fff; width: 90%; max-width: 480px; margin: 10% auto; padding: 25px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); font-family: sans-serif;">
            <h3 style="color: #e4002b; margin-top: 0; font-weight: bold; text-align: center; text-transform: uppercase;">Thông tin nhận hàng</h3>
            <hr style="border: 0; border-top: 1px solid #eee; margin: 15px 0;">

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Họ và tên:</label>
                <input type="text" id="custName" class="form-control" placeholder="Nhập tên người nhận" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;" />
            </div>

            <div style="margin-bottom: 12px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Số điện thoại:</label>
                <input type="tel" id="custPhone" class="form-control" placeholder="Nhập số điện thoại" style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;" />
            </div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-weight: bold; margin-bottom: 5px;">Địa chỉ giao hàng:</label>
                <textarea id="custAddress" class="form-control" rows="3" placeholder="Số nhà, tên đường, phường/xã..." style="width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="closeCheckoutModal()" style="padding: 8px 16px; background: #6c757d; color: #fff; border: none; border-radius: 4px; cursor: pointer;">Hủy bỏ</button>
                <button type="button" onclick="confirmAndPlaceOrder()" style="padding: 8px 20px; background: #e4002b; color: #fff; font-weight: bold; border: none; border-radius: 4px; cursor: pointer;">Xác nhận đặt hàng</button>
            </div>
        </div>
    </div>

</body>

</html>