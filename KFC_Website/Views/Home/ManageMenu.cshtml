@model IEnumerable<KFC_Website.Models.MenuItem>

@{
    ViewBag.Title = "Quản lý thực đơn KFC";
}

<div class="container" style="margin-top: 30px; margin-bottom: 60px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="color: #e4002b; font-weight: bold; margin: 0;">Quản lý Thực Đơn KFC</h2>
        <button class="btn btn-danger" onclick="document.getElementById('addModal').style.display='block'">
            + Thêm món ăn mới
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-bordered table-hover" style="background: #fff;">
        <thead style="background: #202124; color: #fff;">
            <tr>
                <th style="width: 60px; text-align: center;">ID</th>
                <th style="width: 100px; text-align: center;">Hình ảnh</th>
                <th>Tên món ăn</th>
                <th style="width: 150px; text-align: right;">Giá bán</th>
                <th>Mô tả</th>
                <th style="width: 100px; text-align: center;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="text-align: center; vertical-align: middle;">@item.Id</td>
                    <td style="text-align: center;">
                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px;" onerror="this.src='https://via.placeholder.com/60?text=KFC'" />
                    </td>
                    <td style="vertical-align: middle; font-weight: bold;">@item.Name</td>
                    <td style="vertical-align: middle; text-align: right; color: #e4002b; font-weight: bold;">
                        @string.Format("{0:N0} đ", item.Price)
                    </td>
                    <td style="vertical-align: middle; color: #666;">@item.Description</td>
                    <td style="vertical-align: middle; text-align: center;">
                        <form action="@Url.Action("DeleteMenuItem", "Home")" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa món này?');" style="display: inline;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Thêm Món Mới -->
<div id="addModal" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6);">
    <div style="background: #fff; width: 90%; max-width: 500px; margin: 8% auto; padding: 25px; border-radius: 8px;">
        <h3 style="color: #e4002b; margin-top: 0; font-weight: bold;">Thêm món ăn mới</h3>
        <hr />
        <form action="@Url.Action("AddMenuItem", "Home")" method="post">
            <div class="form-group" style="margin-bottom: 12px;">
                <label>Tên món ăn (*):</label>
                <input type="text" name="Name" class="form-control" required placeholder="VD: Gà rán giòn cay" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
                <label>Giá bán (VNĐ) (*):</label>
                <input type="number" name="Price" class="form-control" required placeholder="VD: 39000" />
            </div>
            <div class="form-group" style="margin-bottom: 12px;">
                <label>Link ảnh (URL hoặc đường dẫn tương đối):</label>
                <input type="text" name="ImageUrl" class="form-control" placeholder="/images/ga-ran.png" />
            </div>
            <div class="form-group" style="margin-bottom: 18px;">
                <label>Mô tả ngắn:</label>
                <textarea name="Description" class="form-control" rows="2"></textarea>
            </div>
            <div style="text-align: right; display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn btn-default" onclick="document.getElementById('addModal').style.display='none'">Đóng</button>
                <button type="submit" class="btn btn-danger">Lưu món ăn</button>
            </div>
        </form>
    </div>
</div>