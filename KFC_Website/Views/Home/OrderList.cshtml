@model IEnumerable<KFC_Website.Models.OrderResult>

@{
    ViewBag.Title = "Danh sách đơn hàng";
}

<div class="container" style="margin-top: 30px; margin-bottom: 50px;">
    <h2 style="color: #e4002b; font-weight: bold; text-transform: uppercase;">Quản lý Đơn hàng KFC</h2>
    <p>Tổng số đơn hiện có: <strong>@Model.Count()</strong></p>

    <table class="table table-bordered table-hover" style="background: #fff; margin-top: 20px;">
        <thead style="background-color: #202124; color: #fff;">
            <tr>
                <th>Mã đơn hàng</th>
                <th>Khách hàng</th>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Tổng tiền</th>
                <th>Thời gian đặt</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight: bold; color: #e4002b;">@item.OrderId</td>
                    <td>@item.CustomerName</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td style="font-weight: bold;">@string.Format("{0:N0} đ", item.TotalAmount)</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge" style="background-color: #f39c12; color: #fff; padding: 5px 10px;">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        <a href="@Url.Action("OrderDetails", "Home", new { id = item.OrderId })" class="btn btn-sm btn-info" style="color: #fff;">
                            Xem món
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>